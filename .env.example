# Server-only credentials. Set values in Vercel or an ignored .env.local file.
# Neon Postgres connection string (including sslmode=require).
DATABASE_URL=
# Read/write token for the connected PUBLIC Vercel Blob store.
BLOB_READ_WRITE_TOKEN=

# Optional persistence E2E against an isolated, seeded test environment.
WEB_E2E_BASE_URL=
WEB_E2E_ADMIN_PASSWORD=
